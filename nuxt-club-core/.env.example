# ==============================================================================
# nuxt-club-core - Konfigurace prostředí (.env)
# ==============================================================================

# Šifrovací klíč pro HTTP-only cookie session (nuxt-auth-utils)
# POVINNÉ: Minimálně 32 libovolných náhodných znaků!
# Tip pro vygenerování: openssl rand -base64 32
NUXT_SESSION_PASSWORD=replace_with_a_random_string_of_at_least_32_characters_long

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
# Získejte v Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Přidejte do 'Authorized redirect URIs': http://localhost:3000/auth/google
# (a v produkci např. https://judo-klub.cz/auth/google)
# ------------------------------------------------------------------------------
NUXT_OAUTH_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ------------------------------------------------------------------------------
# Seznam.cz OAuth 2.0 Credentials
# Získejte v administraci pro vývojáře: https://vyvojari.seznam.cz
# Přidejte do 'Návratové URL': http://localhost:3000/auth/seznam
# (a v produkci např. https://judo-klub.cz/auth/seznam)
# ------------------------------------------------------------------------------
NUXT_OAUTH_SEZNAM_CLIENT_ID=your-seznam-oauth-client-id
NUXT_OAUTH_SEZNAM_CLIENT_SECRET=your-seznam-oauth-client-secret

# ------------------------------------------------------------------------------
# Volitelné nastavení přesměrování a cest
# ------------------------------------------------------------------------------
NUXT_PUBLIC_AUTH_LOGIN_PATH=/login
NUXT_PUBLIC_AUTH_REGISTER_PATH=/register
NUXT_PUBLIC_AUTH_DEFAULT_REDIRECT=/
NUXT_PUBLIC_AUTH_UNAUTHORIZED_REDIRECT=/unauthorized
